{
  "name": "ship-mobile-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "testflight": "npx testflight",
    "build:ios": "eas build -p ios --profile production",
    "build:android": "eas build -p android --profile production",
    "submit:ios": "eas build -p ios --profile production --submit",
    "submit:android": "eas build -p android --profile production --submit",
    "deploy:web": "npx expo export -p web && eas deploy --prod",
    "db:types": "npx supabase gen types typescript --project-id YOUR_PROJECT_ID > types/database.types.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.90.20",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.0",
    "expo-blur": "~15.0.0",
    "expo-constants": "~18.0.0",
    "expo-device": "~8.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-linking": "~8.0.0",
    "expo-localization": "^17.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-symbols": "^0.4.5",
    "expo-system-ui": "~6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.5.0",
    "react-native-purchases-ui": "^9.5.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.12.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.0"
  },
  "private": true
}
